KSTARTUP_API_KEY=

# 주간 보고 메일 (scripts/weekly_run.ps1 → python -m grant_radar mail). 없으면 mail 명령만 실패한다.
# 아래 기본 호스트는 Gmail/Google Workspace용이다. 다른 제공자는 SMTP_HOST/PORT를 지정한다.
# SMTP_PASSWORD에는 해당 메일 제공자가 발급한 앱 비밀번호 또는 SMTP 자격 증명을 넣는다.
SMTP_USER=
SMTP_PASSWORD=
REPORT_MAIL_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
